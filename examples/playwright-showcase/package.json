{
  "name": "bddx-playwright-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "A real-world UI and API automation project powered by bddx and Playwright",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "validate": "bddx validate --fail-on-warnings",
    "plan": "bddx plan",
    "test": "bddx run",
    "test:ui": "bddx run --tags @ui",
    "test:api": "bddx run --tags @api",
    "test:smoke": "bddx run --tags @smoke",
    "test:inline": "bddx run --pool inline",
    "verify": "npm run build && npm run validate && npm test"
  },
  "dependencies": {
    "@bddx/axios": "file:../../plugins/axios",
    "@bddx/cli": "file:../../packages/cli",
    "@bddx/core": "file:../../packages/core",
    "@bddx/playwright": "file:../../plugins/playwright",
    "@bddx/reporters": "file:../../packages/reporters",
    "@bddx/runtime": "file:../../packages/runtime",
    "axios": "^1.7.9",
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.10"
  }
}
