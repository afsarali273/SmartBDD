{
  "name": "bddx-selenium-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "A real-world UI automation project powered by bddx and Selenium WebDriver, using the @bddx/selenium plugin",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "validate": "bddx validate --fail-on-warnings",
    "plan": "bddx plan",
    "test": "bddx run",
    "test:smoke": "bddx run --tags @smoke",
    "test:firefox": "bddx run -D browser=firefox",
    "test:inline": "bddx run --pool inline",
    "verify": "npm run build && npm run validate && npm test"
  },
  "dependencies": {
    "@bddx/cli": "file:../../packages/cli",
    "@bddx/core": "file:../../packages/core",
    "@bddx/reporters": "file:../../packages/reporters",
    "@bddx/runtime": "file:../../packages/runtime",
    "@bddx/selenium": "file:../../plugins/selenium",
    "selenium-webdriver": "^4.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/selenium-webdriver": "^4.1.28",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.10"
  }
}
